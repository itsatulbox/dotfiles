[global]
    monitor = 0
    follow = mouse
    width = 360
    height = (0, 200)
    origin = top-right
    offset = (14, 14)
    gap_size = 6
    padding = 12
    horizontal_padding = 14
    frame_width = 2
    frame_color = "#b4befe"
    separator_color = frame
    corner_radius = 8
    font = CaskaydiaMono Nerd Font 10
    format = "<b>%s</b>\n%b"
    icon_position = left
    max_icon_size = 48
    background = "#1e1e2e"
    foreground = "#cdd6f4"

[urgency_low]
    background = "#1e1e2e"
    foreground = "#a6adc8"
    timeout = 4

[urgency_normal]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    timeout = 6

[urgency_critical]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    frame_color = "#f38ba8"
    timeout = 0
