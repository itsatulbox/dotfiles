configuration {
    modi: "drun,run,window";
    show-icons: true;
    drun-display-format: "{name}";
    font: "CaskaydiaMono Nerd Font 12";
}

* {
    bg:      #1e1e2ef2;
    bg-alt:  #313244;
    fg:      #cdd6f4;
    muted:   #a6adc8;
    accent:  #b4befe;
    background-color: transparent;
    text-color: @fg;
}

window {
    width: 600px;
    background-color: @bg;
    border: 2px;
    border-color: @accent;
    border-radius: 10px;
    padding: 14px;
}

mainbox { spacing: 10px; }

inputbar {
    children: [ prompt, entry ];
    spacing: 10px;
    padding: 8px 12px;
    background-color: @bg-alt;
    border-radius: 8px;
}

prompt { text-color: @accent; }
entry { placeholder: "Search apps"; placeholder-color: @muted; }

listview { lines: 8; columns: 1; spacing: 4px; fixed-height: false; }
element { padding: 6px 10px; spacing: 10px; border-radius: 6px; }
element selected { background-color: @accent; text-color: #11111b; }
element-icon { size: 24px; }
element-text { text-color: inherit; vertical-align: 0.5; }
